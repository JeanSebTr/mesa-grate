# swizzles and write masks
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
uniform vec4 c;
void main() { vec4 t = c.wzyx; t.yw = c.xx; gl_FragColor = t; }

[test]
uniform vec4 c 1.0 0.25 0.5 0.75
draw rect -1 -1 2 2
probe all rgba 0.75 1.0 0.25 1.0
