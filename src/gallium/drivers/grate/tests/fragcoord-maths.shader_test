# rounded-rect style distance on gl_FragCoord
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
uniform vec4 rect;
uniform float radius;
void main() {
	vec2 p = gl_FragCoord.xy;
	vec2 q = abs(p - rect.xy) - rect.zw + radius;
	float d = length(max(q, 0.0)) - radius;
	gl_FragColor = vec4(clamp(0.5 - d, 0.0, 1.0));
}

[test]
uniform vec4 rect 125.0 125.0 100.0 100.0
uniform float radius 40.0
draw rect -1 -1 2 2
probe rgba 125 125 1.0 1.0 1.0 1.0
probe rgba 30 30 0.0 0.0 0.0 0.0
probe rgba 30 125 1.0 1.0 1.0 1.0
