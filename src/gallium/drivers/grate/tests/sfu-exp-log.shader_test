# exp2, log2 and pow
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
void main() { gl_FragColor = vec4(exp2(-2.0 * v.x), log2(v.y + 1.0), pow(v.x, 2.0), 1.0); }

[test]
draw rect -1 -1 2 2
relative probe rgba (0.5, 0.5) (0.5, 0.585, 0.25, 1.0)
