# DP3 and DP4
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
uniform vec4 w;
void main() { gl_FragColor = vec4(dot(vec3(v, 1.0), w.xyz), dot(vec4(v, v), w), 0.0, 1.0); }

[test]
uniform vec4 w 0.25 0.25 0.25 0.25
draw rect -1 -1 2 2
relative probe rgba (0.5, 0.5) (0.5, 0.5, 0.0, 1.0)
