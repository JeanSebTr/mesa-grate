# ADD of a varying and a constant
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
uniform float k;
void main() { gl_FragColor = vec4(v.x + k, v.y + k, k, 1.0); }

[test]
uniform float k 0.125
draw rect -1 -1 2 2
relative probe rgba (0.25, 0.75) (0.375, 0.875, 0.125, 1.0)
