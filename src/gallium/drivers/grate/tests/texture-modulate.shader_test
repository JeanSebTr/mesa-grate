# TEX times a varying colour
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
uniform sampler2D tex;
void main() { gl_FragColor = texture2D(tex, v) * vec4(v.x, v.x, v.x, 1.0); }

[test]
texture rgbw 0 (8, 8)
uniform int tex 0
draw rect -1 -1 2 2
relative probe rgba (0.25, 0.25) (0.25, 0.0, 0.0, 1.0)
relative probe rgba (0.75, 0.75) (0.75, 0.75, 0.75, 1.0)
