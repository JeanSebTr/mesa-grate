# TEX with src-over blending (premultiplied)
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
uniform sampler2D tex;
uniform float alpha;
void main() { gl_FragColor = texture2D(tex, v) * alpha; }

[test]
texture rgbw 0 (8, 8)
uniform int tex 0
uniform float alpha 0.5
clear color 0.0 0.0 1.0 1.0
clear
enable GL_BLEND
blend func GL_ONE GL_ONE_MINUS_SRC_ALPHA
draw rect -1 -1 2 2
relative probe rgba (0.25, 0.25) (0.5, 0.0, 0.5, 1.0)
relative probe rgba (0.75, 0.75) (0.5, 0.5, 1.0, 1.0)
