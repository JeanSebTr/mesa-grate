# inversesqrt and sqrt
[require]
GL ES >= 2.0
GLSL ES >= 1.00

[vertex shader]
#version 100
attribute vec4 piglit_vertex;
varying vec2 v;
void main()
{
	gl_Position = piglit_vertex;
	v = piglit_vertex.xy * 0.5 + 0.5;
}

[fragment shader]
#version 100
precision mediump float;
varying vec2 v;
void main() { gl_FragColor = vec4(sqrt(v.x), 0.5 * inversesqrt(v.y + 0.75), 0.0, 1.0); }

[test]
draw rect -1 -1 2 2
relative probe rgba (0.25, 0.25) (0.5, 0.5, 0.0, 1.0)
